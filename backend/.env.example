# ---------------------------------------------------------------------------
# Animal Video Engine - configuration. Copy to backend/.env and edit.
# Everything is optional except what you want to use. Defaults are zero-cost.
# ---------------------------------------------------------------------------

# --- The only API key you need (free, no credit card) ---
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free-tier models to try, in order. Aliases follow Google's current Flash models.
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Zero-cost policy (keep as is) ---
ALLOW_PAID_PROVIDERS=false
SPENDING_LIMIT_USD=0

# --- Optional local LLM fallback when the Gemini free quota runs out ---
# Install https://ollama.com then: ollama pull gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# --- ComfyUI (local images / AI video / AI music) ---
COMFYUI_URL=http://127.0.0.1:8188
COMFY_IMAGE_CHECKPOINT=flux1-schnell-fp8.safetensors
COMFY_IMAGE_STEPS=4
COMFY_IMAGE_CFG=1.0
# Wan 2.2 TI2V-5B (image-to-video). auto = only when an NVIDIA GPU with 8 GB+ is detected.
AI_VIDEO_MODE=auto
COMFY_WAN_UNET=wan2.2_ti2v_5B_fp16.safetensors
COMFY_WAN_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
COMFY_WAN_VAE=wan2.2_vae.safetensors
COMFY_WAN_STEPS=20
COMFY_MUSIC_CHECKPOINT=ace_step_v1_3.5b.safetensors
COMFY_TIMEOUT_S=3600

# --- Voices: the engine picks the best installed voice for the chosen language ---
# English / Hindi : Kokoro            -> pip install kokoro soundfile   (Hindi also needs espeak-ng installed)
# Tamil / Telugu / Hindi : Indic Parler-TTS (natural; best with an NVIDIA GPU)
#                   -> pip install git+https://github.com/huggingface/parler-tts.git
#                      accept the terms at https://huggingface.co/ai4bharat/indic-parler-tts, then: huggingface-cli login
INDIC_PARLER=true
# Piper (fast on any CPU): one .onnx voice per language, e.g.
# PIPER_VOICES=ta=C:/voices/ta_IN-rasa_male-medium.onnx;te=C:/voices/te_IN-xxx.onnx;hi=C:/voices/hi_IN-xxx.onnx
PIPER_VOICES=
PIPER_BIN=piper
# eSpeak NG (robotic, last resort). Leave empty to auto-detect.
ESPEAK_BIN=
KOKORO_VOICE=af_heart

# --- Provider order per job (first available free provider wins) ---
LLM_ORDER=gemini,ollama
IMAGE_ORDER=comfyui-image
VIDEO_ORDER=comfyui-wan,motion-comic
# auto = Kokoro, then Indic Parler first on a GPU / Piper first on CPU, eSpeak last
VOICE_ORDER=auto
MUSIC_ORDER=comfyui-acestep,procedural-score
SFX_ORDER=procedural-sfx

# --- Speed ---
# AI video (Wan) is used for as many scenes as fit in this many minutes; remaining scenes become an animated image montage.
AI_VIDEO_BUDGET_MIN=10
# 0 = automatic (from ComfyUI's GPU memory: 1024 / 896 / 768 / 640 px)
IMAGE_LONG_SIDE=0
# 0 = automatic (number of CPU cores, max 4) for parallel FFmpeg / sound-effect work
PARALLEL_JOBS=0

# --- Server ---
# DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ave   (default: SQLite in DATA_DIR)
# Set a token to require login from the UI (Settings page) - recommended if others can reach your PC.
ENGINE_ACCESS_TOKEN=
# Sites allowed to control this engine (add your hosted UI, e.g. your Vercel URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://animal-video-engine.vercel.app
MAX_UPLOAD_MB=200
INLINE_WORKER=true
MAX_RETRIES=2
RENDER_PRESET=veryfast
